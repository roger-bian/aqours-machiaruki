            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconHanamaru"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_hanamaru"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMari"
